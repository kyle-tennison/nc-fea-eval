# /etc/systemd/system/fea-dispatch.service (or ~/.config/systemd/user/ without User=)
[Unit]
Description=fea-eval dispatcher
After=network-online.target docker.service
Wants=network-online.target

[Service]
# Must be able to talk to Docker (member of the `docker` group).
User=fea
WorkingDirectory=/opt/fea-eval/hosting/dispatch
# FEA_PROXY_URL, FEA_WORKER_TOKEN, optionally FEA_IMAGE
EnvironmentFile=/etc/fea-dispatch.env
ExecStart=/usr/local/bin/uv run --frozen --no-dev fea-dispatch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
